# Port to run the Express backend
PORT=5000

# PostgreSQL Connection String (Supabase or Local)
# Replace with your Supabase connection string if running remotely
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillswap?schema=public"

# Clerk Auth Keys (from dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Upstash Redis Keys (for rate limiting / queue)
# Fallback to local in-memory store will be used if these are empty
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Node Environment
NODE_ENV=development
